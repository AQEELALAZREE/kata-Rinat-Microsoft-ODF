<?xml version="1.0" encoding="UTF-8"?>
<formula-specs category="operators">
  <!-- Arithmetic operators -->
  <formula name="addition">
    <expression>=1+2</expression>
    <expected type="number">3</expected>
    <description>Basic addition</description>
  </formula>
  
  <formula name="subtraction">
    <expression>=5-3</expression>
    <expected type="number">2</expected>
    <description>Basic subtraction</description>
  </formula>
  
  <formula name="multiplication">
    <expression>=3*4</expression>
    <expected type="number">12</expected>
    <description>Basic multiplication</description>
  </formula>
  
  <formula name="division">
    <expression>=10/2</expression>
    <expected type="number">5</expected>
    <description>Basic division</description>
  </formula>
  
  <formula name="exponentiation">
    <expression>=2^3</expression>
    <expected type="number">8</expected>
    <description>Exponentiation (2 to the power of 3)</description>
  </formula>
  
  <!-- Operator precedence -->
  <formula name="precedence_mult_add">
    <expression>=1+2*3</expression>
    <expected type="number">7</expected>
    <description>Multiplication before addition</description>
  </formula>
  
  <formula name="precedence_parens">
    <expression>=(1+2)*3</expression>
    <expected type="number">9</expected>
    <description>Parentheses override precedence</description>
  </formula>
  
  <formula name="precedence_power">
    <expression>=2*3^2</expression>
    <expected type="number">18</expected>
    <description>Exponentiation before multiplication (2*9)</description>
  </formula>
  
  <!-- Comparison operators -->
  <formula name="equal">
    <expression>=5=5</expression>
    <expected type="boolean">TRUE</expected>
    <description>Equality comparison</description>
  </formula>
  
  <formula name="not_equal">
    <expression>=5&lt;&gt;3</expression>
    <expected type="boolean">TRUE</expected>
    <description>Not equal comparison</description>
  </formula>
  
  <formula name="greater_than">
    <expression>=5&gt;3</expression>
    <expected type="boolean">TRUE</expected>
    <description>Greater than comparison</description>
  </formula>
  
  <formula name="less_than">
    <expression>=3&lt;5</expression>
    <expected type="boolean">TRUE</expected>
    <description>Less than comparison</description>
  </formula>
  
  <!-- String concatenation -->
  <formula name="concat_strings">
    <expression>="Hello"&amp;" "&amp;"World"</expression>
    <expected type="string">Hello World</expected>
    <description>String concatenation with &amp; operator</description>
  </formula>
  
  <formula name="concat_number_string">
    <expression>=5&amp;"apples"</expression>
    <expected type="string">5apples</expected>
    <description>Number concatenated with string</description>
  </formula>
  
  <!-- Division by zero -->
  <formula name="div_by_zero">
    <expression>=1/0</expression>
    <expected type="error">#DIV/0!</expected>
    <description>Division by zero produces #DIV/0! error</description>
  </formula>
  
  <!-- Unary operators -->
  <formula name="unary_minus">
    <expression>=-5</expression>
    <expected type="number">-5</expected>
    <description>Unary minus operator</description>
  </formula>
  
  <formula name="unary_plus">
    <expression>=+5</expression>
    <expected type="number">5</expected>
    <description>Unary plus operator</description>
  </formula>
</formula-specs>
