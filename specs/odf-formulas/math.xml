<?xml version="1.0" encoding="UTF-8"?>
<formula-specs category="math">
  <!-- Basic SUM function -->
  <formula name="SUM_basic">
    <expression>=SUM(1,2,3)</expression>
    <expected type="number">6</expected>
    <description>Basic SUM with literal numbers</description>
  </formula>
  
  <formula name="SUM_negative">
    <expression>=SUM(-1,2,-3)</expression>
    <expected type="number">-2</expected>
    <description>SUM with negative numbers</description>
  </formula>
  
  <formula name="SUM_decimals">
    <expression>=SUM(1.5,2.5,3.5)</expression>
    <expected type="number">7.5</expected>
    <description>SUM with decimal numbers</description>
  </formula>
  
  <!-- AVERAGE function -->
  <formula name="AVERAGE_basic">
    <expression>=AVERAGE(1,2,3)</expression>
    <expected type="number">2</expected>
    <description>Basic AVERAGE of three numbers</description>
  </formula>
  
  <formula name="AVERAGE_two">
    <expression>=AVERAGE(10,20)</expression>
    <expected type="number">15</expected>
    <description>AVERAGE of two numbers</description>
  </formula>
  
  <!-- ROUND function -->
  <formula name="ROUND_up">
    <expression>=ROUND(2.5,0)</expression>
    <expected type="number">3</expected>
    <description>ROUND 2.5 to 0 decimals (rounds up)</description>
  </formula>
  
  <formula name="ROUND_down">
    <expression>=ROUND(2.4,0)</expression>
    <expected type="number">2</expected>
    <description>ROUND 2.4 to 0 decimals (rounds down)</description>
  </formula>
  
  <formula name="ROUND_negative_places">
    <expression>=ROUND(123.456,-1)</expression>
    <expected type="number">120</expected>
    <description>ROUND to tens place</description>
  </formula>
  
  <!-- MIN/MAX functions -->
  <formula name="MIN_basic">
    <expression>=MIN(3,1,2)</expression>
    <expected type="number">1</expected>
    <description>MIN of three numbers</description>
  </formula>
  
  <formula name="MAX_basic">
    <expression>=MAX(3,1,2)</expression>
    <expected type="number">3</expected>
    <description>MAX of three numbers</description>
  </formula>
  
  <!-- ABS function -->
  <formula name="ABS_negative">
    <expression>=ABS(-5)</expression>
    <expected type="number">5</expected>
    <description>Absolute value of negative number</description>
  </formula>
  
  <formula name="ABS_positive">
    <expression>=ABS(5)</expression>
    <expected type="number">5</expected>
    <description>Absolute value of positive number</description>
  </formula>
</formula-specs>
